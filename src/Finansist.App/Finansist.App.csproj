<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Finansist.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>Финансист</ApplicationTitle>
    <ApplicationId>ru.finansist.personal</ApplicationId>
    <ApplicationDisplayVersion>0.8.2</ApplicationDisplayVersion>
    <ApplicationVersion>22</ApplicationVersion>
    <SupportedOSPlatformVersion>28.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#26354A" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#26354A" BaseSize="128,128" />
    <MauiImage Include="Resources/Images/*" />
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidNativeLibrary Include="../../.cache/llm/android/arm64-v8a/libfinansist_llm.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="../../.cache/llm/android/x86_64/libfinansist_llm.so" Abi="x86_64" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <ProjectReference Include="../Finansist.Core/Finansist.Core.csproj" />
  </ItemGroup>
</Project>
