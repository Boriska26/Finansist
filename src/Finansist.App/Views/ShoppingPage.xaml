<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:Finansist.Core.ViewModels;assembly=Finansist.Core"
 xmlns:views="clr-namespace:Finansist.App.Views" x:Class="Finansist.App.Views.ShoppingPage" x:Name="Page" x:DataType="vm:ShoppingViewModel" Title="Покупки" SafeAreaEdges="Container">
 <Grid RowDefinitions="Auto,*,Auto" Padding="20,12" RowSpacing="12">
  <VerticalStackLayout Spacing="10">
   <Label Text="Покупки" Style="{StaticResource Title}" />
   <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Списки" Command="{Binding ListTabCommand}" Style="{StaticResource Secondary}" /><Button Grid.Column="1" Text="Каталог" Command="{Binding CatalogCommand}" Style="{StaticResource Secondary}" /></Grid>
   <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" />
   <Border IsVisible="{Binding HasError}"><VerticalStackLayout Spacing="8"><Label Text="{Binding ErrorMessage}" /><Button Text="Обновить" Command="{Binding RefreshCommand}" /></VerticalStackLayout></Border>
  </VerticalStackLayout>
  <CollectionView Grid.Row="1" ItemsSource="{Binding Lists}" IsVisible="{Binding ShowLists}" SelectionMode="None">
   <CollectionView.EmptyView><Label Text="Списков пока нет. Создайте первый список покупок." Style="{StaticResource Muted}" /></CollectionView.EmptyView>
   <CollectionView.ItemTemplate><DataTemplate x:DataType="vm:ShoppingListRow"><Border Margin="0,0,0,10" Padding="16"><VerticalStackLayout Spacing="8">
    <Label Text="{Binding Name}" Style="{StaticResource Section}" /><Label Text="{Binding Details}" Style="{StaticResource Muted}" />
    <Button Text="Открыть список" Command="{Binding ViewModel.OpenListCommand, Source={x:Reference Page}, x:DataType=views:ShoppingPage}" CommandParameter="{Binding .}" Style="{StaticResource Secondary}" />
   </VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate>
  </CollectionView>
  <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="10" IsVisible="{Binding ShowCatalog}">
   <Entry Text="{Binding Search}" Placeholder="Найти товар в каталоге" />
   <CollectionView Grid.Row="1" ItemsSource="{Binding Products}" SelectionMode="None">
    <CollectionView.EmptyView><Label Text="Товаров не найдено. Добавьте товар или измените поиск." Style="{StaticResource Muted}" /></CollectionView.EmptyView>
    <CollectionView.ItemTemplate><DataTemplate x:DataType="vm:ProductRow"><Border Margin="0,0,0,10" Padding="16"><VerticalStackLayout Spacing="8">
     <Label Text="{Binding Name}" Style="{StaticResource Section}" /><Label Text="{Binding Details}" Style="{StaticResource Muted}" />
     <Button Text="Изменить товар" Command="{Binding ViewModel.EditProductCommand, Source={x:Reference Page}, x:DataType=views:ShoppingPage}" CommandParameter="{Binding .}" Style="{StaticResource Secondary}" />
    </VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate>
   </CollectionView>
  </Grid>
  <Grid Grid.Row="2" IsEnabled="{Binding IsIdle}"><Button Text="+ Список покупок" Command="{Binding AddListCommand}" IsVisible="{Binding ShowLists}" /><Button Text="+ Товар" Command="{Binding AddProductCommand}" IsVisible="{Binding ShowCatalog}" /></Grid>
 </Grid>
</ContentPage>
