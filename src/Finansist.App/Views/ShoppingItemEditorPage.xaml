<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:Finansist.Core.ViewModels;assembly=Finansist.Core" x:Class="Finansist.App.Views.ShoppingItemEditorPage"
 x:DataType="vm:ShoppingItemEditorViewModel" Title="Позиция списка" Shell.NavBarIsVisible="True" SafeAreaEdges="Container">
 <Grid RowDefinitions="*,Auto"><ScrollView><VerticalStackLayout Padding="20" Spacing="14">
  <Label Text="Позиция списка" Style="{StaticResource Title}" />
  <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" />
  <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
  <Button Text="Повторить загрузку" Command="{Binding LoadCommand}" IsVisible="{Binding HasError}" Style="{StaticResource Secondary}" />
  <VerticalStackLayout IsEnabled="{Binding IsIdle}" Spacing="12">
   <Label Text="Товар" /><Picker ItemsSource="{Binding Products}" ItemDisplayBinding="{Binding Name, x:DataType=vm:ProductChoice}" SelectedItem="{Binding SelectedProduct}" IsEnabled="{Binding CanChooseProduct}" />
   <VerticalStackLayout IsVisible="{Binding IsNewProduct}" Spacing="12">
    <Label Text="Название нового товара" /><Entry Text="{Binding Name}" MaxLength="80" Placeholder="Например, помидоры" />
    <Label Text="Единица цены и количества" /><Picker ItemsSource="{Binding Units}" SelectedIndex="{Binding UnitIndex}" />
    <Label Text="Примерная цена за единицу, ₽" /><Entry Text="{Binding Price}" Keyboard="Numeric" Placeholder="Можно оставить пустым" />
    <Label Text="Новый товар сохранится и в каталоге. Для упаковки укажите объём в названии, а единицу — «Штуки / упаковки»." Style="{StaticResource Muted}" />
   </VerticalStackLayout>
   <Label Text="Количество" /><Entry Text="{Binding Quantity}" Keyboard="Numeric" Placeholder="Например, 1 или 0,5" />
   <Label Text="Назначение в этом списке" /><Picker ItemsSource="{Binding Purposes}" SelectedIndex="{Binding PurposeIndex}" />
   <Label Text="У существующего товара обычное назначение в каталоге сохранится. Для нового товара это станет обычным назначением." Style="{StaticResource Muted}" />
   <Label Text="Состояние" /><Picker ItemsSource="{Binding States}" SelectedIndex="{Binding StateIndex}" />
   <Button Text="Удалить из списка" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEditing}" Style="{StaticResource Secondary}" />
  </VerticalStackLayout>
 </VerticalStackLayout></ScrollView><Button Grid.Row="1" Text="Сохранить позицию" Command="{Binding SaveCommand}" IsEnabled="{Binding IsIdle}" Margin="16,10" /></Grid>
</ContentPage>
