<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:Finansist.Core.ViewModels;assembly=Finansist.Core" xmlns:views="clr-namespace:Finansist.App.Views"
 x:Class="Finansist.App.Views.ShoppingListPage" x:Name="Page" x:DataType="vm:ShoppingListViewModel" Title="Покупки" Shell.NavBarIsVisible="True" SafeAreaEdges="Container">
 <Grid RowDefinitions="*,Auto">
  <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
   <CollectionView.Header><VerticalStackLayout Padding="20" Spacing="12">
    <Label Text="{Binding Name}" Style="{StaticResource Title}" />
    <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" />
    <Border IsVisible="{Binding HasError}"><VerticalStackLayout Spacing="8"><Label Text="{Binding ErrorMessage}" /><Button Text="Обновить" Command="{Binding RefreshCommand}" /></VerticalStackLayout></Border>
    <Border><VerticalStackLayout Spacing="10">
     <Label Text="{Binding TotalText}" FontSize="24" FontAttributes="Bold" />
     <Label Text="{Binding NecessaryText}" /><Label Text="{Binding JoyText}" />
     <Label Text="{Binding ForecastText}" Style="{StaticResource Muted}" />
    </VerticalStackLayout></Border>
    <Label Text="Цены примерные и могут измениться. Прогноз относится к этому списку. Покупки не создают расходы и не переводят деньги между счетами." Style="{StaticResource Muted}" />
    <Label Text="Добавьте товары из каталога или создайте новый прямо в списке." IsVisible="{Binding IsEmpty}" Style="{StaticResource Muted}" />
   </VerticalStackLayout></CollectionView.Header>
   <CollectionView.ItemTemplate><DataTemplate x:DataType="vm:ShoppingItemRow"><Border Padding="16" Margin="20,0,20,10"><VerticalStackLayout Spacing="8">
    <Label Text="{Binding Name}" Style="{StaticResource Section}" /><Label Text="{Binding Details}" /><Label Text="{Binding Status}" Style="{StaticResource Muted}" />
    <Button Text="{Binding ToggleText}" Command="{Binding ViewModel.ToggleItemCommand, Source={x:Reference Page}, x:DataType=views:ShoppingListPage}" CommandParameter="{Binding .}" Style="{StaticResource Secondary}" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
     <Button Text="Изменить" Command="{Binding ViewModel.EditItemCommand, Source={x:Reference Page}, x:DataType=views:ShoppingListPage}" CommandParameter="{Binding .}" Style="{StaticResource Secondary}" />
     <Button Grid.Column="1" Text="Цена" Command="{Binding ViewModel.EditPriceCommand, Source={x:Reference Page}, x:DataType=views:ShoppingListPage}" CommandParameter="{Binding .}" Style="{StaticResource Secondary}" />
    </Grid>
   </VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate>
   <CollectionView.Footer><VerticalStackLayout Padding="20,10" Spacing="10">
    <Label Text="«Куплено» и «Есть дома» исключены из предстоящих трат. Фактический расход подтверждается отдельно в финансах." Style="{StaticResource Muted}" />
    <Button Text="Переименовать список" Command="{Binding RenameCommand}" Style="{StaticResource Secondary}" />
    <Button Text="Удалить список" Command="{Binding DeleteCommand}" Style="{StaticResource Secondary}" />
   </VerticalStackLayout></CollectionView.Footer>
  </CollectionView>
  <Button Grid.Row="1" Text="+ Товар в список" Command="{Binding AddItemCommand}" IsEnabled="{Binding IsIdle}" Margin="16,10" />
 </Grid>
</ContentPage>
