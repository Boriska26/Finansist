<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:Finansist.Core.ViewModels;assembly=Finansist.Core" x:Class="Finansist.App.Views.StorageStatusView" x:DataType="vm:AppViewModel">
 <VerticalStackLayout Spacing="12">
  <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" SemanticProperties.Description="Работа с хранилищем" />
  <Border IsVisible="{Binding HasError}" BackgroundColor="{AppThemeBinding Light=#FFF1E8, Dark=#3B2921}" Stroke="{AppThemeBinding Light=#D8AA8C, Dark=#AC795D}">
   <VerticalStackLayout Spacing="12">
    <Label Text="Не удалось завершить действие" FontAttributes="Bold" />
    <Label Text="{Binding ErrorMessage}" />
    <Button Text="Повторить подключение" Command="{Binding InitializeCommand}" />
   </VerticalStackLayout>
  </Border>
 </VerticalStackLayout>
</ContentView>
